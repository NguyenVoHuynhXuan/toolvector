---
import "../../style/home/compare-tool.css";
---

<section class="section compare-tool">
    <div class="container">
        <div class="compare-tool__banner">
            <!-- Participants -->
            <div class="compare-tool__participants">
                <span class="compare-tool__name">ChatGPT</span>
                <span class="compare-tool__vs">vs</span>
                <span class="compare-tool__name">Claude</span>
            </div>

            <!-- Description -->
            <p class="compare-tool__desc">
                We tested both across reasoning, writing quality, coding and
                pricing. See the full breakdown and which one wins for your use
                case.
            </p>

            <!-- Button -->
            <a href="#" class="compare-tool__btn"> View comparison &rarr; </a>
        </div>
    </div>
</section>
