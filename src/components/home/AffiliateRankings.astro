function getGradeClass(grade: string): string {
  switch (grade) {
    case 'A+': return 'grade-badge--aplus';
    case 'A': return 'grade-badge--a';
    case 'A-': return 'grade-badge--aminus';
    case 'B+': return 'grade-badge--bplus';
    case 'B': return 'grade-badge--b';
    case 'B-': return 'grade-badge--bminus';
    default: return 'grade-badge--a';
  }
}
---

<section class="section affiliate-rankings" id="affiliate-rankings" aria-label="Affiliate program rankings">
  <div class="container">
    <!-- Header Area matching reference image -->
    <div class="aff-rankings__header">
      <div class="aff-rankings__title-wrap">
        <h2 class="aff-rankings__title">Affiliate program rankings</h2>
        <p class="aff-rankings__subtitle">
          Independent benchmarks across 27 verified affiliate networks and tracking platforms, evaluated on tracking accuracy, payout reliability, and publisher reputation.
        </p>
      </div>

      <!-- Share Button -->
      <button 
        type="button" 
        class="aff-rankings__share-btn" 
        id="shareRankingsBtn" 
        aria-label="Share affiliate program rankings"
        title="Copy share link"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
          <polyline points="16 6 12 2 8 6"></polyline>
          <line x1="12" y1="2" x2="12" y2="15"></line>
        </svg>
        <span>Share</span>
      </button>
    </div>

    <!-- Category Filter Tabs -->
    <div class="aff-rankings__filters" role="tablist" aria-label="Filter rankings by category">
      <button type="button" class="aff-rankings__filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
        All Networks (27)
      </button>
      {categories.map((cat) => (
        <button type="button" class="aff-rankings__filter-btn" data-filter={cat.id} role="tab" aria-selected="false">
          {cat.name} ({cat.items.length})
        </button>
      ))}
    </div>

    <!-- 3-Column Grid -->
    <div class="aff-rankings__grid" id="affRankingsGrid">
      {
        categories.map((cat) => (
          <div class="aff-category-card" data-category={cat.id}>
            <!-- Category Header -->
            <div class="aff-category-card__header">
              <h3 class="aff-category-card__name">{cat.name}</h3>
              <a href="#affiliate-rankings" class="aff-category-card__count" title={`View ${cat.name} rankings`}>
                <span>{cat.countLabel}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>
            </div>

            <!-- Ranked List Items -->
            <div class="aff-category-card__list">
              {
                cat.items.map((item, index) => {
                  const rank = index + 1;
                  const gradeClass = getGradeClass(item.grade);
                  return (
                    <a 
                      href={item.url} 
                      class="aff-item-row"
                      target={item.isInternal ? "_self" : "_blank"}
                      rel={item.isInternal ? "" : "noopener noreferrer"}
                      title={`View ${item.name} (${item.verified})`}
                    >
                      <!-- Rank Number -->
                      <span class="aff-item-row__rank">{rank}</span>

                      <!-- Logo Icon -->
                      <div class="aff-item-row__logo" aria-hidden="true" set:html={item.svg} />

                      <!-- Info -->
                      <div class="aff-item-row__info">
                        <div class="aff-item-row__name-wrap">
                          <span class="aff-item-row__name">{item.name}</span>
                        </div>
                        <span class="aff-item-row__verified">{item.verified}</span>
                      </div>

                      <!-- Score & Grade Badge -->
                      <div class="aff-item-row__score-wrap">
                        <span class="aff-item-row__score">{item.score}</span>
                        <span class={`grade-badge ${gradeClass}`}>{item.grade}</span>
                      </div>
                    </a>
                  );
                })
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="aff-rankings__toast" id="affRankingsToast" role="status" aria-live="polite">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span>Link copied to clipboard!</span>
  </div>
</section>

<script>
  function setupAffiliateRankings() {
    // 1. Share button
    const shareBtn = document.getElementById('shareRankingsBtn');
    const toast = document.getElementById('affRankingsToast');
    let toastTimeout: ReturnType<typeof setTimeout> | null = null;

    if (shareBtn && toast) {
      shareBtn.addEventListener('click', async () => {
        const shareUrl = window.location.origin + window.location.pathname + '#affiliate-rankings';
        const shareData = {
          title: 'Affiliate Program & Network Rankings | ToolVector',
          text: 'Check out the top 27 verified affiliate networks & tracking platforms on ToolVector.',
          url: shareUrl,
        };

        if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
          try {
            await navigator.share(shareData);
            return;
          } catch (err) {
            // User dismissed or fallback to clipboard
          }
        }

        try {
          await navigator.clipboard.writeText(shareUrl);
          toast.classList.add('is-visible');
          if (toastTimeout) clearTimeout(toastTimeout);
          toastTimeout = setTimeout(() => {
            toast.classList.remove('is-visible');
          }, 2400);
        } catch (err) {
          // Fallback alert
          prompt('Copy this link:', shareUrl);
        }
      });
    }

    // 2. Category filter tabs
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.aff-rankings__filter-btn');
    const categoryCards = document.querySelectorAll<HTMLElement>('.aff-category-card');

    if (filterButtons.length && categoryCards.length) {
      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter') || 'all';

          // Update active button state
          filterButtons.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');

          // Filter category cards
          categoryCards.forEach((card) => {
            const cardCat = card.getAttribute('data-category');
            if (filter === 'all' || cardCat === filter) {
              card.classList.remove('is-hidden');
            } else {
              card.classList.add('is-hidden');
            }
          });
        });
      });
    }
  }

  // Run on first load & after view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAffiliateRankings);
  } else {
    setupAffiliateRankings();
  }
  document.addEventListener('astro:page-load', setupAffiliateRankings);
</script>
