const totalToolsCount = categories.reduce((sum, cat) => sum + cat.items.length, 0);

function getGradeClass(grade: Grade): string {
  switch (grade) {
    case 'A+':
      return 'grade-badge--aplus';
    case 'A':
      return 'grade-badge--a';
    case 'A-':
      return 'grade-badge--aminus';
    case 'B+':
      return 'grade-badge--bplus';
    case 'B':
      return 'grade-badge--b';
    case 'B-':
      return 'grade-badge--bminus';
    default:
      return 'grade-badge--a';
  }
}
---

<section class="section affiliate-rankings" id="affiliate-rankings" aria-labelledby="rankings-heading">
  <div class="container">
    <!-- Header Area -->
    <div class="aff-rankings__header">
      <div class="aff-rankings__title-wrap">
        <h2 class="aff-rankings__title" id="rankings-heading">Top software rankings by niche</h2>
        <p class="aff-rankings__subtitle">
          Independent benchmarks across all {categories.length} catalog niches — ranking {totalToolsCount} market-leading platforms alongside hands-on ToolVector editorial evaluations.
        </p>
      </div>

      <!-- Share Button -->
      <button
        type="button"
        class="aff-rankings__share-btn"
        id="shareRankingsBtn"
        aria-label="Share software rankings"
        title="Copy share link"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
          <polyline points="16 6 12 2 8 6"></polyline>
          <line x1="12" y1="2" x2="12" y2="15"></line>
        </svg>
        <span>Share</span>
      </button>
    </div>

    <!-- Niche Filter Tabs (Matching Catalog Categories) -->
    <div class="aff-rankings__filters" role="tablist" aria-label="Filter rankings by catalog niche">
      <button type="button" class="aff-rankings__filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
        All Niches ({totalToolsCount})
      </button>
      {
        categories.map((cat) => (
          <button type="button" class="aff-rankings__filter-btn" data-filter={cat.id} role="tab" aria-selected="false">
            {cat.name} ({cat.items.length})
          </button>
        ))
      }
    </div>

    <!-- 3-Column Leaderboard Grid -->
    <div class="aff-rankings__grid" id="affRankingsGrid">
      {
        categories.map((cat) => {
          const extraCount = Math.max(0, cat.items.length - DEFAULT_VISIBLE);
          return (
            <div class="aff-category-card" data-category={cat.id}>
              <!-- Category Header linking to Catalog page -->
              <div class="aff-category-card__header">
                <h3 class="aff-category-card__name">{cat.name}</h3>
                <a href={`/category/${cat.slug}/`} class="aff-category-card__count" title={`Explore ${cat.name} category`}>
                  <span>{cat.items.length} RANKED</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </a>
              </div>

              <!-- Ranked Tools List -->
              <div class="aff-category-card__list">
                {cat.items.map((item, index) => {
                  const rank = index + 1;
                  const gradeClass = getGradeClass(item.grade);
                  const isExtra = index >= DEFAULT_VISIBLE;
                  return (
                    <a
                      href={item.url}
                      class:list={['aff-item-row', { 'is-extra': isExtra }]}
                      target={item.isReviewed ? '_self' : '_blank'}
                      rel={item.isReviewed ? undefined : 'noopener noreferrer'}
                      title={item.isReviewed ? `Read our full ${item.name} review` : `Visit ${item.name}`}
                    >
                      <!-- Rank Number -->
                      <span class="aff-item-row__rank">{rank}</span>

                      <!-- Logo Icon -->
                      {item.logoSrc ? (
                        <div class="aff-item-row__logo">
                          <img src={item.logoSrc} alt={item.name} width="36" height="36" loading="lazy" />
                        </div>
                      ) : (
                        <div class="aff-item-row__logo" aria-hidden="true" set:html={item.svg} />
                      )}

                      <!-- Info -->
                      <div class="aff-item-row__info">
                        <div class="aff-item-row__name-wrap">
                          <span class="aff-item-row__name">{item.name}</span>
                          {item.isReviewed && <span class="aff-item-row__review-pill">Reviewed</span>}
                        </div>
                        <span class="aff-item-row__verified">{item.subtitle}</span>
                      </div>

                      <!-- Score & Grade Badge -->
                      <div class="aff-item-row__score-wrap">
                        <span class="aff-item-row__score">{item.score}</span>
                        <span class={`grade-badge ${gradeClass}`}>{item.grade}</span>
                      </div>
                    </a>
                  );
                })}
              </div>

              {extraCount > 0 && (
                <button
                  type="button"
                  class="aff-category-card__more"
                  data-expand-card
                  data-more-label={`Show +${extraCount} more in ${cat.name}`}
                  data-less-label="Show top 6"
                >
                  <span>Show +{extraCount} more in {cat.name}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
              )}
            </div>
          );
        })
      }

      <!-- 12th Card (Completes 3x4 Desktop Grid when viewing All Niches) -->
      <div class="aff-category-card aff-category-card--cta" data-category="__summary">
        <div class="aff-category-card__cta-box">
          <span class="aff-category-card__cta-badge">Scoring Methodology</span>
          <h3 class="aff-category-card__cta-title">How ToolVector Scores Every Tool</h3>
          <p class="aff-category-card__cta-desc">
            Rankings combine real workflow benchmarks, pricing transparency, data-privacy controls, and reliability signals. Tools marked <strong>Reviewed</strong> include a full hands-on teardown on ToolVector.
          </p>
          <div class="aff-category-card__cta-links">
            <a href="/blog/" class="aff-category-card__cta-btn aff-category-card__cta-btn--primary">
              Browse All Reviews &rarr;
            </a>
            <a href="/contact/" class="aff-category-card__cta-btn aff-category-card__cta-btn--ghost">
              Submit Your Project
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="aff-rankings__toast" id="affRankingsToast" role="status" aria-live="polite">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span>Link copied to clipboard!</span>
  </div>
</section>

<script>
  function setupAffiliateRankings() {
    const grid = document.getElementById('affRankingsGrid');
    if (!grid || grid.dataset.initialized === 'true') return;
    grid.dataset.initialized = 'true';

    // 1. Share button
    const shareBtn = document.getElementById('shareRankingsBtn');
    const toast = document.getElementById('affRankingsToast');
    let toastTimeout: ReturnType<typeof setTimeout> | null = null;

    if (shareBtn && toast) {
      shareBtn.addEventListener('click', async () => {
        const shareUrl = window.location.origin + window.location.pathname + '#affiliate-rankings';
        const shareData = {
          title: 'Top Software Rankings by Niche | ToolVector',
          text: 'Explore independent rankings across all 11 software niches on ToolVector.',
          url: shareUrl,
        };

        if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
          try {
            await navigator.share(shareData);
            return;
          } catch {
            // Fallback to clipboard
          }
        }

        try {
          await navigator.clipboard.writeText(shareUrl);
          toast.classList.add('is-visible');
          if (toastTimeout) clearTimeout(toastTimeout);
          toastTimeout = setTimeout(() => {
            toast.classList.remove('is-visible');
          }, 2400);
        } catch {
          prompt('Copy this link:', shareUrl);
        }
      });
    }

    // 2. Expand/collapse cards with >6 ranked tools
    const expandButtons = grid.querySelectorAll<HTMLButtonElement>('[data-expand-card]');
    expandButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.aff-category-card');
        if (!card) return;
        const expanded = card.classList.toggle('is-expanded');
        const labelSpan = btn.querySelector('span');
        if (labelSpan) {
          labelSpan.textContent = expanded
            ? btn.dataset.lessLabel || 'Show less'
            : btn.dataset.moreLabel || 'Show more';
        }
      });
    });

    // 3. Category filter tabs
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.aff-rankings__filter-btn');
    const categoryCards = grid.querySelectorAll<HTMLElement>('.aff-category-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';

        filterButtons.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        grid.classList.toggle('is-single-niche', filter !== 'all');

        categoryCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (filter === 'all') {
            card.classList.remove('is-hidden');
          } else if (cardCat === filter) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAffiliateRankings);
  } else {
    setupAffiliateRankings();
  }
  document.addEventListener('astro:page-load', setupAffiliateRankings);
</script>
