---
import { getCollection } from 'astro:content';
import ArticleFeedCard from './ArticleFeedCard.astro';
import '../../style/home/trending-week.css';

const blogPosts = await getCollection('blog');
const reviewPosts = await getCollection('reviews');

// 6 newest articles
const posts = [...blogPosts, ...reviewPosts]
  .sort((a, b) => new Date(b.data.date || 0).valueOf() - new Date(a.data.date || 0).valueOf())
  .slice(0, 6);
---

<section class="section section--alt trending-week" id="reviews">
  <div class="container">
    <div class="section-header trending-week__header">
      <div class="trending-week__title-group">
        <h2 class="section-title">Trending this week</h2>
        <p class="section-subtitle trending-week__subtitle"><span></span> All current reviews, newest first</p>
      </div>
      <a href="/blog/" class="trending-week__link">Browse all articles &rarr;</a>
    </div>
    <div class="article-feed-grid" id="trending-feed-grid">
      {
        posts.map((post, index) => {
          const delay = (0.04 + (index % 6) * 0.07).toFixed(2);
          const brandSlug = (post.data.name || post.id).toLowerCase();
          return (
            <div
              class="trending-card-wrapper"
              id={`project-${post.id}`}
              data-project-id={post.id}
              data-brand-slug={brandSlug}
              data-animate={`trending-fade-up 0.85s cubic-bezier(0.16, 1, 0.3, 1) both ${delay}s`}
              style={`--card-delay: ${delay}s;`}
            >
              <div class="card-selected-badge" aria-hidden="true">
                <span class="badge-dot"></span>
                <span>Selected Tool</span>
              </div>
              <ArticleFeedCard post={post} />
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  function setupTrendingAnimate() {
    const items = document.querySelectorAll('.trending-week .trending-card-wrapper');
    if (!items.length) return;

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const anim = el.getAttribute('data-animate');
          if (anim) {
            el.style.animation = anim;
          }
          el.classList.add('is-visible');
          obs.unobserve(el);
        }
      });
    }, {
      rootMargin: '0px 0px -4% 0px',
      threshold: 0.05
    });

    items.forEach(item => observer.observe(item));
  }

  setupTrendingAnimate();
  document.addEventListener('astro:page-load', setupTrendingAnimate);
</script>
