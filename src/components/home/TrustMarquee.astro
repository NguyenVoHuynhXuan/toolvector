---
// src/components/home/TrustMarquee.astro
import '../../style/home/trust-marquee.css';

import asanaSvg from '../../assets/brands/asana.svg?raw';
import intercomSvg from '../../assets/brands/intercom.svg?raw';
import hubspotSvg from '../../assets/brands/hubspot.svg?raw';
import clickupSvg from '../../assets/brands/clickup.svg?raw';
import aircallSvg from '../../assets/brands/aircall.svg?raw';
import notionSvg from '../../assets/brands/notion.svg?raw';
import figmaSvg from '../../assets/brands/figma.svg?raw';

const logos = [
  { name: 'Asana', classModifier: 'asana', svg: asanaSvg },
  { name: 'Intercom', classModifier: 'intercom', svg: intercomSvg },
  { name: 'HubSpot', classModifier: 'hubspot', svg: hubspotSvg },
  { name: 'ClickUp', classModifier: 'clickup', svg: clickupSvg },
  { name: 'Aircall', classModifier: 'aircall', svg: aircallSvg },
  { name: 'Notion', classModifier: 'notion', svg: notionSvg },
  { name: 'Figma', classModifier: 'figma', svg: figmaSvg },
];

// Double the items in each group so it spans wide/ultrawide displays seamlessly
const marqueeItems = [...logos, ...logos];
---

<section class="trusted-teams" aria-label="Trusted by 200,000+ builders, founders, and teams worldwide">
  <div class="trusted-teams__header">
    <p class="trusted-teams__title">Trusted by 200,000+ builders, founders, and teams worldwide</p>
  </div>

  <div class="trusted-teams__marquee-wrapper">
    <div class="trusted-teams__track">
      {[false, true].map((isDuplicate) => (
        <div class="trusted-teams__group" aria-hidden={isDuplicate ? 'true' : undefined}>
          {marqueeItems.map((logo) => (
            <div
              class={`trusted-teams__item trusted-teams__item--${logo.classModifier}`}
              title={logo.name}
              aria-label={isDuplicate ? undefined : logo.name}
              tabindex={isDuplicate ? -1 : undefined}
              set:html={logo.svg}
            />
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
