---
import '../../style/home/testimonials.css';

interface TestimonialItem {
  name: string;
  role: string;
  company: string;
  category: string;
  quote: string;
  image: string;
  readLabel: string;
  readUrl: string;
}

const testimonials: TestimonialItem[] = [
  {
    name: 'David Chen',
    role: 'Senior Full-Stack Developer',
    company: 'CloudScale Labs',
    category: 'Developer Tools',
    quote:
      "What I love is they don't just list features — they actually test the tools with real tasks and point out the weaknesses too. That honesty saved our engineering team from two noisy subscriptions.",
    image: 'https://i.pravatar.cc/300?img=11',
    readLabel: 'CodeRabbit Review',
    readUrl: '/blog/coderabbit-review/',
  },
  {
    name: 'Sarah Nguyen',
    role: 'Founder & Operations Lead',
    company: 'BrightLeaf Studio',
    category: 'AI Workflow',
    quote:
      "As a small business owner, I don't have time to trial every AI tool myself. Their breakdowns explain real workflows, data privacy rules, and hidden limits clearly — even for non-technical teammates.",
    image: 'https://i.pravatar.cc/300?img=32',
    readLabel: 'PriorityEngine Guide',
    readUrl: '/blog/ai-email-prioritization-system/',
  },
  {
    name: 'James Park',
    role: 'Independent Product Designer',
    company: 'Park Creative',
    category: 'Creative & Visual AI',
    quote:
      "I used to trust whatever AI tool had the flashiest launch video. Now I check ToolVector first — the credit math and pricing audits tell me what I'm actually paying for before I subscribe.",
    image: 'https://i.pravatar.cc/300?img=12',
    readLabel: 'Pixelcut Review',
    readUrl: '/blog/pixelcut-review/',
  },
  {
    name: 'Elena Rostova',
    role: 'Head of Organic Growth',
    company: 'MetricPulse',
    category: 'SEO & Marketing',
    quote:
      'Most software directories read like rewritten landing pages. ToolVector calls out where automation works and where human editorial review is still mandatory. Our whole marketing team bookmarks it.',
    image: 'https://i.pravatar.cc/300?img=47',
    readLabel: 'RankYak Review',
    readUrl: '/blog/rankyak-review/',
  },
  {
    name: 'Marcus Vance',
    role: 'Revenue Operations Manager',
    company: 'Northstar B2B',
    category: 'Sales & Outreach',
    quote:
      'When we evaluated LinkedIn outreach and inbox tools, their side-by-side seat pricing and account-safety notes were spot on. We cut our evaluation cycle from three weeks to an afternoon.',
    image: 'https://i.pravatar.cc/300?img=53',
    readLabel: 'Aimfox Review',
    readUrl: '/blog/aimfox-review/',
  },
  {
    name: 'Hannah Lin',
    role: 'Remote Engineering Manager',
    company: 'NomadStack',
    category: 'Global Connectivity',
    quote:
      'Before international offsites, I used ToolVector to compare eSIM data plans and throttling policies across regions. Zero fluff, transparent pros and cons, and accurate real-world pricing.',
    image: 'https://i.pravatar.cc/300?img=44',
    readLabel: 'GigSky Review',
    readUrl: '/blog/gigsky/',
  },
];
---

<section class="section testimonials" id="testimonials" aria-labelledby="testimonials-heading">
  <div class="container">
    <!-- Top Header + Trust Summary + Carousel Controls -->
    <div class="testimonials__header">
      <div class="testimonials__intro">
        <div class="testimonials__eyebrow">
          <span class="testimonials__eyebrow-dot" aria-hidden="true"></span>
          <span>Verified Reader Feedback</span>
        </div>
        <h2 class="testimonials__title" id="testimonials-heading">
          Why teams &amp; builders <span>love working with us —</span>
        </h2>
        <p class="testimonials__subtitle">
          Developers, founders, and operations leads rely on ToolVector’s independent testing to benchmark pricing, security, and real-world fit before committing to a stack.
        </p>
      </div>

      <div class="testimonials__controls-panel">
        <div class="testimonials__rating-pill" aria-label="Average reader satisfaction 4.9 out of 5">
          <div class="testimonials__rating-stars" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <span class="testimonials__rating-score"><strong>4.9/5</strong> Reader Trust</span>
        </div>

        <div class="testimonials__nav" aria-label="Testimonial slider navigation">
          <button type="button" class="testimonials__nav-btn" id="testimonials-prev" aria-label="Previous testimonials" disabled>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
          <button type="button" class="testimonials__nav-btn" id="testimonials-next" aria-label="Next testimonials">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Flush 3-Column Snap Carousel Track -->
    <div class="testimonials__track" id="testimonials-track" tabindex="0" aria-label="Reader testimonials">
      {
        testimonials.map((item) => {
          const initials = item.name
            .split(' ')
            .map((part) => part[0])
            .join('')
            .slice(0, 2)
            .toUpperCase();

          return (
            <article class="testimonial-card">
              <div class="testimonial-card__top">
                <div class="testimonial-card__stars" aria-label="5 out of 5 stars">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </div>
                <span class="testimonial-card__tag">{item.category}</span>
              </div>

              <blockquote class="testimonial-card__quote">“{item.quote}”</blockquote>

              <div class="testimonial-card__footer">
                <div class="testimonial-card__person">
                  <div class="testimonial-card__avatar">
                    <img
                      src={item.image}
                      alt={item.name}
                      class="testimonial-card__img"
                      width="52"
                      height="52"
                      loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                    />
                    <span class="testimonial-card__initials" aria-hidden="true">{initials}</span>
                  </div>
                  <div class="testimonial-card__author">
                    <div class="testimonial-card__name-row">
                      <span class="testimonial-card__name">{item.name}</span>
                      <svg class="testimonial-card__verified" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-label="Verified reader">
                        <circle cx="12" cy="12" r="10" fill="currentColor" fill-opacity="0.14" />
                        <path d="m8.5 12.3 2.3 2.3 4.8-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </div>
                    <div class="testimonial-card__role">
                      {item.role} · <span>{item.company}</span>
                    </div>
                  </div>
                </div>

                <a href={item.readUrl} class="testimonial-card__context">
                  <span>Read: {item.readLabel}</span>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17 17 7"></path>
                    <path d="M7 7h10v10"></path>
                  </svg>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Pagination Bar -->
    <div class="testimonials__bottom-bar">
      <div class="testimonials__pagination" id="testimonials-dots" role="tablist" aria-label="Choose testimonial slide">
        {
          testimonials.map((_, idx) => (
            <button
              type="button"
              class:list={['testimonials__dot', { active: idx === 0 }]}
              data-slide={idx}
              aria-label={`Go to testimonial position ${idx + 1}`}
            />
          ))
        }
      </div>
      <span class="testimonials__counter" id="testimonials-counter" aria-live="polite">01 / 04</span>
    </div>

    <!-- Editorial Independence & Action Banner -->
    <div class="testimonials__cta">
      <div class="testimonials__cta-copy">
        <div class="testimonials__cta-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </div>
        <div>
          <h3 class="testimonials__cta-title">100% Independent Editorial Testing — Never Pay-to-Rank</h3>
          <p class="testimonials__cta-desc">
            Every review audits live pricing tiers, quota limits, and data-handling policies so your team can adopt software with clear eyes.
          </p>
        </div>
      </div>

      <div class="testimonials__cta-actions">
        <a href="/blog/" class="testimonials__btn testimonials__btn--primary">
          Explore All Reviews
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
        <a href="/contact/" class="testimonials__btn testimonials__btn--secondary">Submit a Tool</a>
      </div>
    </div>
  </div>
</section>

<script>
  function setupTestimonials() {
    const track = document.getElementById('testimonials-track') as HTMLElement | null;
    const prevBtn = document.getElementById('testimonials-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('testimonials-next') as HTMLButtonElement | null;
    const counterEl = document.getElementById('testimonials-counter');
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('#testimonials-dots .testimonials__dot'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#testimonials-track .testimonial-card'));

    if (!track || !cards.length || !dots.length) return;
    if (track.dataset.initialized === 'true') return;
    track.dataset.initialized = 'true';

    const getMetrics = () => {
      const step =
        cards.length > 1
          ? cards[1].offsetLeft - cards[0].offsetLeft
          : cards[0].getBoundingClientRect().width + 24;
      const visible = Math.max(1, Math.round((track.clientWidth - 24) / step));
      const maxIndex = Math.max(0, cards.length - visible);
      const current = step > 0 ? Math.min(maxIndex, Math.max(0, Math.round(track.scrollLeft / step))) : 0;
      return { step, visible, maxIndex, current };
    };

    const pad = (n: number) => String(n).padStart(2, '0');

    const syncUI = () => {
      const { maxIndex, current } = getMetrics();
      const totalStops = maxIndex + 1;

      dots.forEach((dot, idx) => {
        dot.hidden = idx >= totalStops;
        dot.classList.toggle('active', idx === current);
      });

      if (prevBtn) prevBtn.disabled = current <= 0;
      if (nextBtn) nextBtn.disabled = current >= maxIndex;
      if (counterEl) counterEl.textContent = `${pad(current + 1)} / ${pad(totalStops)}`;
    };

    const goTo = (index: number) => {
      const { step, maxIndex } = getMetrics();
      const clamped = Math.min(maxIndex, Math.max(0, index));
      track.scrollTo({
        left: clamped * step,
        behavior: 'smooth',
      });
    };

    track.addEventListener('scroll', syncUI, { passive: true });
    window.addEventListener('resize', syncUI, { passive: true });

    prevBtn?.addEventListener('click', () => {
      const { current } = getMetrics();
      goTo(current - 1);
    });

    nextBtn?.addEventListener('click', () => {
      const { current } = getMetrics();
      goTo(current + 1);
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => goTo(idx));
    });

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        const { current } = getMetrics();
        goTo(current + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        const { current } = getMetrics();
        goTo(current - 1);
      }
    });

    syncUI();
  }

  setupTestimonials();
  document.addEventListener('astro:page-load', setupTestimonials);
</script>
