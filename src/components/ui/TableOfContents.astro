---
interface Heading { depth: number; slug: string; text: string; }
interface Props { headings: Heading[]; }
const { headings } = Astro.props;
const toc = headings.filter((heading) => heading.depth > 1 && heading.depth < 4);
---

{toc.length > 0 && (
  <nav class="toc" aria-label="Table of contents">
    <h3 class="toc-title">Table of Contents</h3>
    <ul class="toc-list">
      {toc.map((heading) => (
        <li class:list={['toc-item', `depth-${heading.depth}`]}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  function initToc() {
    const toc = document.querySelector<HTMLElement>('.toc');
    if (!toc || toc.dataset.ready) return;
    toc.dataset.ready = 'true';
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.id;
        toc.querySelectorAll('a').forEach((link) => {
          link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
        });
      });
    }, { rootMargin: '-18% 0px -72% 0px' });
    document.querySelectorAll('.prose h2, .prose h3').forEach((heading) => observer.observe(heading));
  }
  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>

<style>
  .toc {
    padding: 22px 20px;
    border: 1px solid var(--color-border-base);
    border-radius: 18px;
    background: var(--color-bg-base);
    box-shadow: var(--shadow-sm);
  }

  .toc-title {
    margin: 0 0 16px;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-dark);
    letter-spacing: -0.015em;
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 320px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .toc-list::-webkit-scrollbar {
    width: 4px;
  }

  .toc-list::-webkit-scrollbar-thumb {
    background: var(--color-border-base);
    border-radius: 4px;
  }

  .toc-item a {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
    padding: 4px 0 4px 12px;
    border-left: 3px solid transparent;
  }

  .toc-item.depth-3 a {
    padding-left: 22px;
    font-size: 0.82rem;
  }

  .toc-item a:hover {
    color: var(--color-primary);
  }

  .toc-item a.active {
    color: var(--color-primary);
    border-left-color: var(--color-primary);
    font-weight: 600;
  }
</style>
