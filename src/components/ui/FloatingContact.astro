---
// src/components/ui/FloatingContact.astro
---

<div class="floating-contact" aria-label="Quick contact buttons">
  <!-- Hotline / Phone -->
  <a href="tel:+84900000000" class="floating-contact__btn floating-contact__btn--phone" aria-label="Call Hotline" title="Call Hotline">
    <span class="floating-contact__pulse"></span>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
  </a>

  <!-- Messenger -->
  <a href="https://m.me/toolvector" target="_blank" rel="noopener noreferrer" class="floating-contact__btn floating-contact__btn--messenger" aria-label="Facebook Messenger" title="Chat via Messenger">
    <span class="floating-contact__pulse"></span>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2C6.48 2 2 6.03 2 11c0 2.83 1.45 5.37 3.73 6.98.2.14.32.37.33.62l.06 1.94c.03.8.88 1.34 1.59.97l2.17-1.12c.18-.09.39-.11.58-.06.82.22 1.69.34 2.54.34 5.52 0 10-4.03 10-9s-4.48-9-10-9zm5.32 7.02l-2.61 4.15c-.41.65-1.29.83-1.92.38l-2.07-1.55c-.17-.13-.4-.13-.57 0l-2.8 2.13c-.5.38-1.16-.18-.89-.75l2.61-4.15c.41-.65 1.29-.83 1.92-.38l2.07 1.55c.17.13.4.13.57 0l2.8-2.13c.5-.38 1.16.18.89.75z"/>
    </svg>
  </a>

  <!-- Zalo -->
  <a href="https://zalo.me/0900000000" target="_blank" rel="noopener noreferrer" class="floating-contact__btn floating-contact__btn--zalo" aria-label="Chat via Zalo" title="Chat via Zalo">
    <span class="floating-contact__pulse"></span>
    <span class="zalo-text">Zalo</span>
  </a>
</div>

<style>
  .floating-contact {
    position: fixed;
    right: 22px;
    bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    z-index: 999;
  }

  .floating-contact__btn {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
    cursor: pointer;
  }

  .floating-contact__btn:hover {
    transform: scale(1.12) translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.36);
  }

  .floating-contact__btn--phone {
    background: linear-gradient(135deg, #ef4444, #dc2626);
  }

  .floating-contact__btn--messenger {
    background: linear-gradient(135deg, #ff5252, #e0245e);
  }

  .floating-contact__btn--zalo {
    background: #0068ff;
  }

  .zalo-text {
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: -0.02em;
    font-family: inherit;
  }

  /* Pulse animation */
  .floating-contact__pulse {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid currentColor;
    opacity: 0.5;
    animation: contactPulse 2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
    pointer-events: none;
  }

  @keyframes contactPulse {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    70% {
      transform: scale(1.35);
      opacity: 0;
    }
    100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }

  @media (max-width: 600px) {
    .floating-contact {
      right: 14px;
      bottom: 18px;
      gap: 10px;
    }
    .floating-contact__btn {
      width: 42px;
      height: 42px;
    }
    .floating-contact__btn svg {
      width: 18px;
      height: 18px;
    }
    .zalo-text {
      font-size: 0.72rem;
    }
  }
</style>
