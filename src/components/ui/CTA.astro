---
interface Props {
  title?: string;
  link: string;
  btnText: string;
  disclaimer?: string;
  size?: 'normal' | 'lg';
  bgGradient?: string;
  btnBg?: string;
  btnColor?: string;
  bgImage?: string;
  theme?: 'dark' | 'light-center';
  bgSize?: string;
  bgPos?: string;
  floatingImage?: string;
}

const { 
  title = "Ready to explore this tool?", 
  link, 
  btnText, 
  disclaimer = "We may earn a commission if you make a purchase, at no extra cost to you.",
  size = 'normal',
  bgGradient = "linear-gradient(135deg, #06351e, #0a4b2a)",
  btnBg = "#fff",
  btnColor = "#07371f",
  bgImage,
  theme = 'dark',
  bgSize,
  bgPos,
  floatingImage
} = Astro.props;

const defaultBgPos = theme === 'light-center' ? 'center center' : 'right center';
const defaultBgSize = theme === 'light-center' ? 'cover' : 'contain';

const finalBgPos = bgPos || defaultBgPos;
const finalBgSize = bgSize || defaultBgSize;

const bgStyle = bgImage 
  ? `background: url('${bgImage}') no-repeat ${finalBgPos} / ${finalBgSize}, ${bgGradient};` 
  : `background: ${bgGradient};`;
---

<div class={`cta-block ${size === 'lg' ? 'cta-block--lg' : ''} ${floatingImage ? 'cta-block--has-floating-image' : ''}`} style={bgStyle} data-theme={theme}>
  {title && <h3>{title}</h3>}
  <a href={link} target="_blank" rel="noopener noreferrer sponsored" class={`cta-block__btn ${size === 'lg' ? 'cta-block__btn--lg' : ''}`} style={`background-color: ${btnBg}; color: ${btnColor};`}>
    {btnText}
  </a>
  {disclaimer && <span class="cta-block__disclaimer">{disclaimer}</span>}
  {floatingImage && <img src={floatingImage} alt="" class="cta-block__floating-image" />}
</div>

<style>
  .cta-block {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    margin: 2.4rem 0 !important;
    padding: 30px 34px 25px;
    border-radius: 16px;
    box-shadow: 0 15px 32px rgba(3,45,24,.17);
  }
  .cta-block__floating-image {
    position: absolute;
    right: 3%;
    top: 50%;
    transform: translateY(-50%);
    max-height: 80%;
    max-width: 45%;
    object-fit: contain;
    z-index: 2;
    pointer-events: none;
  }
  .cta-block--lg {
    margin: 2.8rem 0 !important;
    padding: 38px 40px 31px;
  }
  .cta-block h3 {
    margin: 0 0 8px 0;
    color: #f4ffe9;
    font-size: clamp(1.35rem,2.4vw,1.8rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -.04em;
  }
  .cta-block--lg h3 {
    font-size: clamp(1.55rem,3vw,2.15rem);
  }
  .cta-block__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 50px;
    margin: 13px 0 0;
    padding: 0 21px;
    font-weight: 800;
    border-radius: 7px;
    text-decoration: none !important;
    font-size: .95rem;
    font-family: system-ui,sans-serif;
    transition: transform .2s, opacity .2s;
  }
  .cta-block__btn:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }
  .cta-block--has-floating-image h3,
  .cta-block--has-floating-image .cta-block__disclaimer {
    max-width: 52%;
    z-index: 3;
    position: relative;
  }
  .cta-block--has-floating-image .cta-block__btn {
    z-index: 3;
    position: relative;
  }
  .cta-block__btn--lg {
    min-height: 56px;
    padding: 0 25px;
    font-size: 1rem;
  }
  .cta-block__disclaimer {
    display: block;
    margin-top: 14px;
    color: #c5dec9;
    font-size: .76rem;
    font-style: italic;
    text-align: left;
    line-height: 1.5;
    font-weight: 500;
  }

  @media(max-width:620px) {
    .cta-block, .cta-block--lg { padding:25px 22px 21px; }
    .cta-block__btn { width: 100%; min-height: 54px; font-size: 1rem; }
    .cta-block h3 { font-size: 1.55rem; }
    .cta-block__disclaimer { font-size: .84rem; }
    .cta-block--has-floating-image h3,
    .cta-block--has-floating-image .cta-block__disclaimer { max-width: 100%; }
    .cta-block__floating-image { display: none; }
  }

  .cta-block[data-theme="light-center"] {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background-color: #f3f7fb;
  }
  .cta-block[data-theme="light-center"] h3 {
    order: 1;
    color: #0f172a;
    font-size: clamp(1.65rem,3.2vw,2.4rem);
    margin-bottom: 12px;
  }
  .cta-block[data-theme="light-center"] .cta-block__disclaimer {
    order: 2;
    color: #1e293b;
    font-size: 1.05rem;
    font-style: normal;
    text-align: center;
    margin-top: 5px;
    margin-bottom: 25px;
    line-height: 1.6;
    max-width: 600px;
  }
  .cta-block[data-theme="light-center"] .cta-block__btn {
    order: 3;
    margin-top: 0;
  }
</style>
