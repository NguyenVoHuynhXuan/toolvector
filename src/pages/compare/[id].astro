---
import { getCollection } from 'astro:content';
import EditorialArticlePage from '../../components/article/EditorialArticlePage.astro';
import { getComparisonEntries } from '../../utils/contentHelpers';

export async function getStaticPaths() {
  const posts = await getCollection('compare');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const allComparisons = await getComparisonEntries();
const relatedItems = allComparisons.filter((item) => item.id !== post.id).slice(0, 3);
---

<EditorialArticlePage post={post} kind="compare" relatedItems={relatedItems} />
