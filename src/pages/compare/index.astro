---
import Layout from "../../layout/Layout.astro";
import { Image } from 'astro:assets';
import { getComparisonEntries, resolveAssetUrl } from "../../utils/contentHelpers";
import "../../style/pages/directory.css";

const comparisons = await getComparisonEntries();
const uniqueCategories = Array.from(
  new Set(comparisons.map((item) => item.entry.data.category).filter(Boolean))
) as string[];
---

<Layout
  title="Software Comparisons (Head-to-Head 2026) — ToolVector"
  description="Side-by-side head-to-head comparisons across pricing, performance, security, and real workflow fit to help you choose the winning software."
>
  <main class="hub-page">
    <section class="container">
      <div class="hub-hero">
        <span class="hub-hero__eyebrow">Head-to-Head Comparisons</span>
        <h1 class="hub-hero__title">Software Matchups Without the Hype</h1>
        <p class="hub-hero__subtitle">
          Direct 1-vs-1 and 3-way comparisons testing real pricing math, hidden limits, and which tool wins for your exact use case.
        </p>
      </div>

      <div class="hub-toolbar">
        <div class="hub-search-box">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            type="search"
            id="compare-filter-input"
            placeholder="Search comparisons (e.g., Waalaxy, Coddy, ClickFunnels, RedTrack)..."
            aria-label="Filter comparisons"
          />
          <span class="hub-count-badge" id="compare-count-badge">
            {comparisons.length} {comparisons.length === 1 ? 'comparison' : 'comparisons'}
          </span>
        </div>

        {uniqueCategories.length > 0 && (
          <div class="hub-pills" role="tablist" aria-label="Filter comparisons by category">
            <button type="button" class="hub-pill is-active" data-cat="">All Comparisons</button>
            {uniqueCategories.map((cat) => (
              <button type="button" class="hub-pill" data-cat={cat}>{cat}</button>
            ))}
          </div>
        )}
      </div>

      {comparisons.length > 0 ? (
        <div class="hub-grid" id="compare-grid">
          {comparisons.map((item) => {
            const post = item.entry;
            const hero = post.data.thumbnail || post.data.logo;
            const title = post.data.name || item.id;
            const contenders = title.includes(' vs ')
              ? title.split(/\s+vs\.?\s+/i).map((c) => c.trim())
              : [];
            const searchText = `${title} ${post.data.description || ''} ${post.data.category || ''} ${item.id}`.toLowerCase();

            return (
              <a
                href={item.url}
                class="hub-card"
                data-search={searchText}
                data-category={post.data.category || ''}
              >
                <div class="hub-card__media">
                  {hero ? (
                    typeof hero === 'string' ? (
                      <img src={resolveAssetUrl(hero) || hero} alt={title} class="hub-card__img" loading="lazy" />
                    ) : (
                      <Image src={hero} alt={title} class="hub-card__img" />
                    )
                  ) : (
                    <div class="hub-card__placeholder">{title}</div>
                  )}
                  <span class="hub-card__badge">{post.data.category || 'Comparison'}</span>
                </div>

                <div class="hub-card__body">
                  {contenders.length >= 2 && (
                    <div class="hub-card__vs-row">
                      {contenders.map((c, idx) => (
                        <>
                          {idx > 0 && <span class="hub-card__vs-sep">vs</span>}
                          <span class="hub-card__vs-chip">{c}</span>
                        </>
                      ))}
                    </div>
                  )}
                  <h2 class="hub-card__title">{title}</h2>
                  <p class="hub-card__excerpt">{post.data.description}</p>
                  <div class="hub-card__footer">
                    <span class="hub-card__date">
                      {new Date(post.data.date || 0).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric',
                      })}
                    </span>
                    <span class="hub-card__cta">Read comparison &rarr;</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="hub-empty-state">
          <p>New head-to-head comparisons are being prepared in <code>src/content/compare/</code>.</p>
        </div>
      )}

      <div class="hub-empty-state" id="compare-empty-state" hidden>
        <p>No comparisons matched your search criteria.</p>
        <button type="button" id="compare-reset-btn" class="hub-reset-btn">Reset filters</button>
      </div>
    </section>
  </main>
</Layout>

<script>
  function initCompareFilter() {
    const input = document.getElementById('compare-filter-input') as HTMLInputElement | null;
    const countBadge = document.getElementById('compare-count-badge');
    const emptyState = document.getElementById('compare-empty-state');
    const resetBtn = document.getElementById('compare-reset-btn');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#compare-grid .hub-card'));
    const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.hub-pill'));

    if (!input || !cards.length) return;
    let activeCat = '';

    const applyFilter = () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const hay = card.dataset.search || '';
        const cat = card.dataset.category || '';
        const show = (!q || hay.includes(q)) && (!activeCat || cat === activeCat);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (countBadge) {
        countBadge.textContent = `${visible} ${visible === 1 ? 'comparison' : 'comparisons'}`;
      }
      if (emptyState) {
        emptyState.hidden = visible > 0;
      }
    };

    input.addEventListener('input', applyFilter);
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        activeCat = pill.dataset.cat || '';
        applyFilter();
      });
    });

    resetBtn?.addEventListener('click', () => {
      input.value = '';
      activeCat = '';
      pills.forEach((p, idx) => p.classList.toggle('is-active', idx === 0));
      applyFilter();
    });

    applyFilter();
  }

  document.addEventListener('DOMContentLoaded', initCompareFilter);
  document.addEventListener('astro:page-load', initCompareFilter);
  initCompareFilter();
</script>
