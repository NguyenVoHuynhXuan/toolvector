---
import { getCollection } from 'astro:content';
import EditorialArticlePage from '../../components/article/EditorialArticlePage.astro';
import { isComparisonPost, type UnifiedArticleEntry } from '../../utils/contentHelpers';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const allPosts = await getCollection('blog');
const relatedItems: UnifiedArticleEntry[] = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const aMatch =
      (a.data.category && a.data.category === post.data.category) ||
      (a.data.serviceType && a.data.serviceType === post.data.serviceType)
        ? 1
        : 0;
    const bMatch =
      (b.data.category && b.data.category === post.data.category) ||
      (b.data.serviceType && b.data.serviceType === post.data.serviceType)
        ? 1
        : 0;
    if (bMatch !== aMatch) return bMatch - aMatch;
    return new Date(b.data.date || 0).valueOf() - new Date(a.data.date || 0).valueOf();
  })
  .slice(0, 3)
  .map((entry) => ({
    id: entry.id,
    collection: 'blog',
    kind: isComparisonPost(entry) ? 'compare' : 'review',
    url: `/blog/${entry.id}/`,
    entry,
  }));
---

<EditorialArticlePage post={post} relatedItems={relatedItems} />
