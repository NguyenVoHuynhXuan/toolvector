---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layout/Layout.astro';
import TableOfContents from '../../components/ui/TableOfContents.astro';
import '../../style/pages/article.css';

const svgAssets = import.meta.glob<{ default: { src: string } }>('../../assets/**/*.svg', { eager: true });

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const resolvedLogoSrc = typeof post.data.logo === 'string' ? (svgAssets[post.data.logo]?.default?.src || svgAssets[post.data.logo]?.default || post.data.logo) : post.data.logo?.src;
const { Content, headings } = await render(post);
const category = post.data.category || post.data.serviceType || post.data.foodType || 'Software Review';
const publishedDate = post.data.date
  ? new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(`${post.data.date}T00:00:00`))
  : undefined;
const readingTime = Math.max(3, Math.ceil((post.body?.replace(/<[^>]*>/g, ' ').match(/\S+/g)?.length || 600) / 220));

// Extract H1 from markdown headings if present, otherwise fallback
const mdxTitle = headings.find((h) => h.depth === 1)?.text;
const articleTitle = mdxTitle || `${post.data.name} Review 2026: Is It Worth It?`;

const heroImage = post.data.thumbnail || post.data.logo;
const toolName = post.data.name || 'Featured Tool';
const toolInitials = toolName.slice(0, 2).toUpperCase();

// Derive Rating, Review Count, Price, and Free Trial for the Tool Summary Card
const bodyText = post.body || '';
const ratingMatch =
  bodyText.match(/\*\*([345]\.\d)\s*\/\s*5(?:\.0)?\*\*/) ||
  bodyText.match(/([345]\.\d)\s*\/\s*5(?:\.0)?\s*stars?/i) ||
  bodyText.match(/Overall(?:\s+Score|\s+Rating)[^\n]*?([345]\.\d)\s*\/\s*5/i);
const ratingDisplay = post.data.rating ? post.data.rating.toFixed(1) : (ratingMatch ? ratingMatch[1] : '4.6');

const revCount = post.data.reviewsCount || 0;
let reviewsDisplay: string | null = null;
if (revCount >= 1_000_000) {
  reviewsDisplay = `(${(revCount / 1_000_000).toFixed(revCount % 1_000_000 === 0 ? 0 : 1).replace(/\.0$/, '')}M+)`;
} else if (revCount >= 1_000) {
  reviewsDisplay = `(${(revCount / 1_000).toFixed(revCount >= 10_000 || revCount % 1_000 === 0 ? 0 : 1).replace(/\.0$/, '')}k+)`;
} else if (revCount >= 20) {
  reviewsDisplay = `(${revCount}+)`;
}

const priceDisplay = (post.data.startingPrice || 'Free / Paid Plans').replace(/\s*[·|]\s*/g, ' • ');

const combinedPromo = `${post.data.startingPrice || ''} | ${post.data.promo || ''}`;
const hasNoCard = /no credit card|no card/i.test(combinedPromo);
const dayTrialMatch = combinedPromo.match(/(\d+)[- ]day\s+free\s+trial/i) || bodyText.match(/\b(\d+)[- ]day\s+free\s+trial\b/i);
const moneyBackMatch = combinedPromo.match(/(\d+)[- ]day\s+money[- ]back/i) || bodyText.match(/\b(\d+)[- ]day\s+money[- ]back\b/i);

let freeTrialDisplay = post.data.freeTrial || '';
if (!freeTrialDisplay) {
  if (/free forever|\$0 forever|free basic plan|100%\s*free\s*to\s*join/i.test(combinedPromo)) {
    freeTrialDisplay = hasNoCard ? 'Free Forever Plan (No Credit Card)' : 'Free Forever Plan';
  } else if (dayTrialMatch) {
    freeTrialDisplay = `${dayTrialMatch[1]}-Day Free Trial${hasNoCard ? ' (No Credit Card)' : ''}`;
  } else if (/^free\b|free tier|free plan|free signup|free standard|free credits|free trial/i.test(combinedPromo)) {
    freeTrialDisplay = hasNoCard ? 'Free Plan (No Credit Card)' : 'Free Plan Available';
  } else if (moneyBackMatch) {
    freeTrialDisplay = `${moneyBackMatch[1]}-Day Money-Back Guarantee`;
  } else {
    freeTrialDisplay = 'Official Plans Available';
  }
}

const pageUrl = Astro.url.href;
const pageTitle = encodeURIComponent(articleTitle);

// Related articles query (matches category/serviceType, sorted by date, top 3)
const allPosts = await getCollection('blog');
const otherPosts = allPosts.filter((p) => p.id !== post.id);
const relatedPosts = otherPosts
  .sort((a, b) => {
    const aMatch = (a.data.category && a.data.category === post.data.category) || (a.data.serviceType && a.data.serviceType === post.data.serviceType) ? 1 : 0;
    const bMatch = (b.data.category && b.data.category === post.data.category) || (b.data.serviceType && b.data.serviceType === post.data.serviceType) ? 1 : 0;
    if (bMatch !== aMatch) return bMatch - aMatch;
    return new Date(b.data.date || 0).valueOf() - new Date(a.data.date || 0).valueOf();
  })
  .slice(0, 3);
---

<Layout
  title={`${articleTitle} | ToolVector`}
  description={post.data.metaDescription || post.data.description || ''}
  ogImage={resolvedLogoSrc}
>
  <main class="article-page">

    <!-- Breadcrumb -->
    <div class="article-breadcrumb container">
      <nav aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="article-breadcrumb__sep">&gt;</span>
        <a href="/blog/">Blog</a>
        <span class="article-breadcrumb__sep">&gt;</span>
        <span class="article-breadcrumb__current">{articleTitle}</span>
      </nav>
    </div>

    <!-- Full-width Featured Thumbnail -->
    {heroImage && (
      <div class="article-thumb container">
        {typeof heroImage === 'string' ? (
          <img src={heroImage} alt={`${post.data.name} hero thumbnail`} class="article-thumb__img" width="1200" height="630" loading="eager" />
        ) : (
          <Image src={heroImage} alt={`${post.data.name} hero thumbnail`} class="article-thumb__img" width={1200} height={630} loading="eager" />
        )}
      </div>
    )}

    <!-- Main 2-column layout -->
    <section class="article-layout container">

      <!-- Left: Article content -->
      <article class="article-content">

        <!-- Category tag + Social Share row -->
        <div class="article-meta-row">
          <span class="article-category-tag">{category}</span>
          <div class="article-share">
            <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${pageTitle}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X" class="article-share__link">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" class="article-share__link">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"/></svg>
            </a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" class="article-share__link">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M14 13.5h2.5l1-4H14v-2.5c0-1.07.33-1.8 1.83-1.8H17.5V1.65c-.66-.09-1.92-.15-3.32-.15-3.29 0-5.54 2-5.54 5.7V9.5H5.5v4h3.14V23h5.36V13.5z"/></svg>
            </a>
          </div>
        </div>

        <!-- Article title & subtle byline -->
        <header class="article-header">
          <h1>{articleTitle}</h1>
          <div class="article-byline">
            <span>By <strong>ToolVector Editorial</strong></span>
            {publishedDate && (
              <>
                <span class="article-byline__sep">·</span>
                <span>Updated {publishedDate}</span>
              </>
            )}
            <span class="article-byline__sep">·</span>
            <span>{readingTime} min read</span>
          </div>
        </header>

        <div class="prose"><Content /></div>
      </article>

      <!-- Right: Sticky sidebar -->
      <aside class="article-sidebar">

        <!-- Tool Summary Card (Top) -->
        <div class="tool-summary-card">
          <div class="tool-summary-card__header">
            <div class="tool-summary-card__logo-wrap">
              {post.data.logo ? (
                typeof post.data.logo === 'string' ? (
                  <img src={resolvedLogoSrc} alt={`${toolName} logo`} width="44" height="44" class="tool-summary-card__logo" />
                ) : (
                  <Image src={post.data.logo} alt={`${toolName} logo`} width={88} height={88} class="tool-summary-card__logo" />
                )
              ) : (
                <span class="tool-summary-card__initials">{toolInitials}</span>
              )}
            </div>
            <div class="tool-summary-card__titles">
              <p class="tool-summary-card__name">{toolName}</p>
              <p class="tool-summary-card__category">{category}</p>
            </div>
          </div>

          <div class="tool-summary-card__specs">
            <div class="tool-summary-card__row">
              <span class="tool-summary-card__label">Rating</span>
              <span class="tool-summary-card__rating">
                <svg width="15" height="15" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.447a1 1 0 00-.364 1.118l1.287 3.957c.3.921-.755 1.688-1.54 1.118l-3.368-2.447a1 1 0 00-1.175 0l-3.368 2.447c-.784.57-1.838-.197-1.539-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.049 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.3-3.957z" />
                </svg>
                <strong>{ratingDisplay}</strong>
                {reviewsDisplay && <span class="tool-summary-card__reviews">{reviewsDisplay}</span>}
              </span>
            </div>

            <div class="tool-summary-card__row">
              <span class="tool-summary-card__label">Price</span>
              <span class="tool-summary-card__price">{priceDisplay}</span>
            </div>

            <div class="tool-summary-card__row">
              <span class="tool-summary-card__label">Free Trial</span>
              <span class="tool-summary-card__trial">{freeTrialDisplay}</span>
            </div>
          </div>

          {post.data.link && (
            <a href={post.data.link} target="_blank" rel="noopener noreferrer sponsored" class="tool-summary-card__cta">
              <span>Visit {toolName}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          )}
        </div>

        <!-- Table of Contents (Bottom) -->
        <TableOfContents headings={headings} />

      </aside>
    </section>

    <!-- Related articles -->
    {relatedPosts.length > 0 && (
      <section class="related-section container">
        <div class="related-section__header">
          <h2 class="related-section__title">Related articles</h2>
          <a href="/blog/" class="related-section__view-all">View all</a>
        </div>

        <div class="related-grid">
          {relatedPosts.map((relPost) => {
            const relHero = relPost.data.thumbnail || relPost.data.logo;
            const relDate = relPost.data.date
              ? new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(`${relPost.data.date}T00:00:00`))
              : '';
            const relCategory = relPost.data.category || relPost.data.serviceType || 'Travel Tips';
            const relTitle = relPost.data.name.toLowerCase().includes('review')
              ? relPost.data.name
              : `${relPost.data.name} Review 2026: Is It Worth It?`;
            const relInitials = (relPost.data.name || 'TV').slice(0, 2).toUpperCase();

            return (
              <a href={`/blog/${relPost.id}/`} class="related-card">
                <div class="related-card__thumb">
                  {relHero ? (
                    typeof relHero === 'string' ? (
                      <img src={relHero} alt={relPost.data.name} class="related-card__img" width="400" height="250" loading="lazy" />
                    ) : (
                      <Image src={relHero} alt={relPost.data.name} class="related-card__img" width={400} height={250} loading="lazy" />
                    )
                  ) : (
                    <div class="related-card__placeholder" />
                  )}
                </div>

                <div class="related-card__body">
                  <span class="related-card__tag">{relCategory}</span>
                  <h3 class="related-card__title">{relTitle}</h3>

                  <div class="related-card__footer">
                    <div class="related-card__author">
                      <span class="related-card__avatar">{relInitials}</span>
                      <span>by ToolVector Editorial</span>
                    </div>
                    {relDate && <span class="related-card__date">{relDate}</span>}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </main>
</Layout>
