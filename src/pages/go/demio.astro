<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <!-- SEO -->
        <meta name="robots" content="noindex, nofollow" />
        <meta name="referrer" content="strict-origin-when-cross-origin" />

        <title>Redirecting to Demio...</title>

        <!-- Performance -->
        <link rel="preconnect" href="https://demio.com?fp_ref=duy-yen-e218a3" />
        <link
            rel="dns-prefetch"
            href="https://demio.com?fp_ref=duy-yen-e218a3"
        />

        <!-- JavaScript Redirect -->
        <script>
            window.location.replace("https://demio.com?fp_ref=duy-yen-e218a3");
        </script>

        <!-- Fallback nếu JavaScript bị tắt -->
        <noscript>
            <meta
                http-equiv="refresh"
                content="0;url=https://demio.com?fp_ref=duy-yen-e218a3"
            />
        </noscript>
    </head>

    <body style="display: none;">
        <noscript>
            <p>
                Redirecting to
                <a
                    href="https://demio.com?fp_ref=duy-yen-e218a3"
                    rel="nofollow"
                >
                    Demio
                </a>
            </p>
        </noscript>
    </body>
</html>
