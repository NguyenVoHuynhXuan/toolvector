<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <!-- SEO -->
        <meta name="robots" content="noindex, nofollow" />
        <meta name="referrer" content="strict-origin-when-cross-origin" />

        <title>Redirecting to Pixelcut...</title>

        <!-- Performance -->
        <link rel="preconnect" href="https://www.pixelcut.ai/" />
        <link rel="dns-prefetch" href="https://www.pixelcut.ai/" />

        <!-- JavaScript Redirect -->
        <script>
            window.location.replace("https://www.pixelcut.ai/");
        </script>

        <!-- Fallback if JavaScript is disabled -->
        <noscript>
            <meta http-equiv="refresh" content="0;url=https://www.pixelcut.ai/" />
        </noscript>
    </head>

    <body style="display: none;">
        <noscript>
            <p>
                Redirecting to Pixelcut...
                <a href="https://www.pixelcut.ai/" rel="nofollow">
                    Click here if you are not redirected automatically
                </a>
            </p>
        </noscript>
    </body>
</html>
