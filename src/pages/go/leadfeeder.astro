<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <!-- SEO -->
        <meta name="robots" content="noindex, nofollow" />
        <meta name="referrer" content="strict-origin-when-cross-origin" />

        <title>Redirecting...</title>

        <!-- Performance -->
        <link
            rel="preconnect"
            href="https://leadfeeder.partnerlinks.io/t0hzifd3fdrg"
        />
        <link
            rel="dns-prefetch"
            href="https://leadfeeder.partnerlinks.io/t0hzifd3fdrg"
        />

        <!-- JavaScript Redirect -->
        <script>
            window.location.replace(
                "https://leadfeeder.partnerlinks.io/t0hzifd3fdrg",
            );
        </script>

        <!-- Fallback nếu JavaScript bị tắt -->
        <noscript>
            <meta
                http-equiv="refresh"
                content="0;url=https://leadfeeder.partnerlinks.io/t0hzifd3fdrg"
            />
        </noscript>
    </head>

    <body style="display: none;">
        <noscript>
            <p>
                Redirecting to
                <a
                    href="https://leadfeeder.partnerlinks.io/t0hzifd3fdrg"
                    rel="nofollow"
                >
                    Redirect
                </a>
            </p>
        </noscript>
    </body>
</html>
