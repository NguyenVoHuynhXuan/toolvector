<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <!-- SEO -->
        <meta name="robots" content="noindex, nofollow" />
        <meta name="referrer" content="strict-origin-when-cross-origin" />

        <title>Redirecting...</title>

        <!-- Performance -->
        <link
            rel="preconnect"
            href="https://go.saily.site/aff_c?offer_id=101&aff_id=15537"
        />
        <link
            rel="dns-prefetch"
            href="https://go.saily.site/aff_c?offer_id=101&aff_id=15537"
        />

        <!-- JavaScript Redirect -->
        <script>
            window.location.replace(
                "https://go.saily.site/aff_c?offer_id=101&aff_id=15537",
            );
        </script>

        <!-- Fallback nếu JavaScript bị tắt -->
        <noscript>
            <meta http-equiv="refresh" content="0;url=https://go.saily.site/aff_c?offer_id=101&aff_id=15537" />
        </noscript>
    </head>

    <body style="display: none;">
        <noscript>
            <p>
                Redirecting to
                <a
                    href="https://go.saily.site/aff_c?offer_id=101&aff_id=15537"
                    rel="nofollow"
                >
                    Redirect
                </a>
            </p>
        </noscript>
    </body>
</html>
