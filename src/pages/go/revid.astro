<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <!-- SEO -->
        <meta name="robots" content="noindex, nofollow" />
        <meta name="referrer" content="strict-origin-when-cross-origin" />

        <title>Redirecting...</title>

        <!-- Performance -->
        <link rel="preconnect" href="https://www.revid.ai/?via=duy-yen" />
        <link rel="dns-prefetch" href="https://www.revid.ai/?via=duy-yen" />

        <!-- JavaScript Redirect -->
        <script>
            window.location.replace("https://www.revid.ai/?via=duy-yen");
        </script>

        <!-- Fallback nếu JavaScript bị tắt -->
        <noscript>
            <meta
                http-equiv="refresh"
                content="0;url=https://www.revid.ai/?via=duy-yen"
            />
        </noscript>
    </head>

    <body style="display: none;">
        <noscript>
            <p>
                Redirecting to
                <a href="https://www.revid.ai/?via=duy-yen" rel="nofollow">
                    Redirect
                </a>
            </p>
        </noscript>
    </body>
</html>
